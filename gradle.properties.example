# Example gradle.properties for Maven Central publishing
# Copy this to ~/.gradle/gradle.properties and fill in your values
#
# IMPORTANT: Central Publishing Portal requires token-based authentication
# Get your token from: https://central.sonatype.com/ (User Token section)

# Central Publishing Portal - Token Authentication (REQUIRED)
# Generate token at: https://central.sonatype.com/
# 1. Login to https://central.sonatype.com/
# 2. Go to User Token section
# 3. Generate a new token
# 4. Copy the token and paste it below
mavenCentralToken=your-portal-token-here
# Alternative property name:
# sonatypeToken=your-portal-token-here

# Username (may be required with token, check your token documentation)
mavenCentralUsername=your-ossrh-username
# Alternative property name:
# ossrhUsername=your-ossrh-username

# Legacy OSSRH - Username/Password (fallback if token not provided)
# Note: Central Portal prefers token authentication
mavenCentralPassword=your-ossrh-password
# Alternative property names:
# ossrhPassword=your-ossrh-password

# GPG signing configuration
signing.keyId=your-gpg-key-id
signingKey=your-gpg-private-key-armored
signingPassword=your-gpg-key-passphrase
# Alternative: use secretKeyRingFile instead of signingKey
# signing.secretKeyRingFile=/path/to/your/secring.gpg

